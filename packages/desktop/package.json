{
  "name": "@opencode/desktop",
  "private": true,
  "version": "2.1.3",
  "type": "module",
  "license": "MIT",
  "homepage": "https://physicalsystems.ai",
  "author": {
    "name": "Physical Systems"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "bun test --timeout 30000",
    "dev": "bun ./scripts/dev.ts",
    "migration": "bun ./scripts/migration.ts",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --dir --config physical-review.config.ts",
    "package:mac": "electron-builder --mac --dir --config physical-review.config.ts",
    "package:win": "electron-builder --win --dir --config physical-review.config.ts",
    "package:linux": "electron-builder --linux --dir --config physical-review.config.ts",
    "bench:startup": "bun ./scripts/bench-startup.ts",
    "native:build": "bun install --cwd native"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@zip.js/zip.js": "2.7.62",
    "electron-context-menu": "5.0.0",
    "electron-log": "^5",
    "electron-updater": "6.8.9",
    "lighthouse": "13.4.1",
    "builder-util-runtime": "9.7.0",
    "electron-store": "11.0.2",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@brendonovich/vite-plugin-opencode": "0.1.3",
    "@effect/platform-node": "catalog:",
    "@lydell/node-pty": "catalog:",
    "@opencode/app": "workspace:*",
    "@opencode/gui-extensions": "workspace:*",
    "@opencode/client": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/ui": "workspace:*",
    "@sentry/solid": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@solidjs/router": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "app-builder-lib": "26.15.7",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "electron": "44.9.1",
    "electron-builder": "26.15.7",
    "electron-vite": "6.0.0-beta.1",
    "magic-string": "0.30.21",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "8.2.2"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.12"
  }
}
